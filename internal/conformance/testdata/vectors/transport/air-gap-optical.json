{
  "$schema": "../../schema/vector.schema.json",
  "id": "transport.air-gap-optical",
  "name": "Air-Gap Optical Transport v1 (BRC-141)",
  "brc": ["BRC-141"],
  "version": "1.0.0",
  "reference_impl": "@bsv/air-gap@0.1.1",
