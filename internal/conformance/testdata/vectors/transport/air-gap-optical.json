      "id": "transport.air-gap-optical.crc32.1",
      "description": "IEEE CRC-32 check value for ASCII \"123456789\"",
      "input": {
        "operation": "crc32",
        "message_hex": "313233343536373839"
      },
      "expected": {
        "crc32_hex": "cbf43926"
      },
      "tags": ["happy-path"]
    },
    {
      "id": "transport.air-gap-optical.length.2",
      "description": "exact rendered part length for blockBytes 1",
      "input": {
        "operation": "part-char-length",
        "block_bytes": 1
      },
      "expected": {
        "chars": 40
      },
      "tags": ["happy-path"]
    },
    {
